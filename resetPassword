# Exit on errors
# Great explanation on https://vaneyckt.io/posts/safer_bash_scripts_with_set_euxo_pipefail/
set -Eeuo pipefail

PASSWORD="${1}"
PASSWORD_INIT_TIMEOUT="${2:-30}"
PASSWORD_INIT_RETRIES="${3:-5}"

# ALTER USER SYS runs in CDB$ROOT only and succeeds reliably.
# ALTER USER SYSTEM propagates to all PDBs (ORA-65048) and can hit
# ORA-04021 (DDL lock timeout) if FREEPDB1 background processes
# (undo tablespace resize, statistics gathering) hold dictionary locks
# during startup. Retry with backoff to ride out the contention.
resetUser() {
  local user="${1}"
  local attempt
  for attempt in $(seq 1 "${PASSWORD_INIT_RETRIES}"); do
    if sqlplus -s / as sysdba << EOSQL
      WHENEVER SQLERROR EXIT SQL.SQLCODE
      ALTER SESSION SET DDL_LOCK_TIMEOUT = ${PASSWORD_INIT_TIMEOUT};
      ALTER USER ${user} IDENTIFIED BY "${PASSWORD}";
      exit;
EOSQL
    then
      return 0
    fi
    echo "CONTAINER: ALTER USER ${user} failed (attempt ${attempt}/${PASSWORD_INIT_RETRIES}), retrying in ${attempt}0s..."
    sleep $((attempt * 10))
  done
  echo "CONTAINER: ERROR - ALTER USER ${user} failed after ${PASSWORD_INIT_RETRIES} attempts."
  return 1
}

resetUser "SYS"
resetUser "SYSTEM"
